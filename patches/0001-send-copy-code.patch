+        code: finalDto.code,
+        buttonText: finalDto.buttonText,
+        footer: finalDto.footer,
+      });
+    } catch (error) {
+      return this.failSend(sessionId, 'text', message, finalDto, error);
+    }
+    return this.persistSentState(message, result);
+  }
