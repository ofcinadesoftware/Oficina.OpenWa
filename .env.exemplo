# Copie para .env (chmod 600). Gere os segredos na VM com: openssl rand -hex 32
# Versão em uso: a mesma do tag que está no checkout (git describe --tags).
OPENWA_VERSION=0.26.0
OPENWA_HOST=wa.oficinadesoftware.com
API_MASTER_KEY=
API_KEY_PEPPER=
# Sub-rede da kidmoney_edge (onde está o Caddy)
TRUSTED_PROXIES=172.18.0.0/16
# Serviços (na rede "openwa") que recebem webhook, separados por vírgula. Hosts públicos não precisam.
SSRF_ALLOWED_HOSTS=hikyachat-api,hikyachat-api-sandbox,karfy-api,karfy-sandbox-api,kidmoney-api,kidmoney-api-sandbox
# OPENWA_MEM_LIMIT=3g
# ENABLE_SWAGGER=true
